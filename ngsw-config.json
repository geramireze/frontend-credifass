{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "name": "CrediFass",
    "description": "Crédito al instante y rápido"
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**/*.woff2",
          "/**/*.woff"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-freshness",
      "urls": ["/v1/dashboard**", "/v1/reportes**", "/v1/clientes**", "/v1/prestamos**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "5m",
        "timeout": "8s"
      }
    },
    {
      "name": "api-performance",
      "urls": ["/v1/usuarios**", "/v1/auditoria**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 20,
        "maxAge": "2m"
      }
    },
    {
      "name": "cf-catalogo",
      "urls": [
        "/v1/cf/categorias",
        "/v1/cf/productos**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "5m",
        "timeout": "4s"
      }
    },
    {
      "name": "cf-clientes",
      "urls": [
        "/v1/cf/clientes**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "5m",
        "timeout": "4s"
      }
    },
    {
      "name": "cf-dashboard",
      "urls": [
        "/v1/cf/dashboard"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "2m",
        "timeout": "3s"
      }
    },
    {
      "name": "cf-ventas",
      "urls": [
        "/v1/cf/ventas**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "3m",
        "timeout": "4s"
      }
    },
    {
      "name": "cf-reservas",
      "urls": [
        "/v1/cf/reservas**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 30,
        "maxAge": "5m",
        "timeout": "4s"
      }
    }
  ]
}
